# HealthVerse AI Agent Service Environment Variables
AI_PROVIDER=ollama
# Local Ollama Inference Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b # Options: qwen2.5:3b (recommended for fast GPU inference), qwen2.5:7b

# Optional Cloud Provider Fallback (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

PORT=8000
HOST=0.0.0.0
